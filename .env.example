# Moonraker API URL
MOONRAKER_URL=URL

# go2rtc URL
GO2RTC_URL=URL

# URL publique HTTPS
PUBLIC_BASE_URL=URL

# Server port
PORT=8080

# CORS (activer si besoin d'accès depuis autre domaine)
CORS_ENABLED=true

# Refresh interval (ms) pour les requêtes Moonraker
REFRESH_INTERVAL=1000

# Tapo P110
TAPO_EMAIL=EMAIL
TAPO_PASSWORD=PASSWORD
TAPO_DEVICE_IP=x.x.x.x

# Couts
ELECTRICITY_EUR_PER_KWH=0.25
MACHINE_EUR_PER_HOUR=0.30
FILAMENT_EUR_PER_KG=20
